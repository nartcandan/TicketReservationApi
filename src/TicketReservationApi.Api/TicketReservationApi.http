@TicketReservationApi_HostAddress = http://localhost:5133
@eventId = 00000000-0000-0000-0000-000000000000
@reservationId = 00000000-0000-0000-0000-000000000000

# Development seed users (ali, ayse, can @test.local) share the password "Passw0rd!".
# The admin account comes from user-secrets: dotnet user-secrets list --project src/TicketReservationApi.Api
@adminEmail = admin@ticketreservation.local
@adminPassword = <from user-secrets>

### Login as user
# @name userLogin
POST {{TicketReservationApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ali@test.local",
  "password": "Passw0rd!"
}

### Login as admin
# @name adminLogin
POST {{TicketReservationApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Register
POST {{TicketReservationApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "new.user@test.local",
  "password": "Passw0rd!",
  "fullName": "New User"
}

### List events (public)
GET {{TicketReservationApi_HostAddress}}/api/events
Accept: application/json

### Get event (public)
GET {{TicketReservationApi_HostAddress}}/api/events/{{eventId}}
Accept: application/json

### Create event (admin)
POST {{TicketReservationApi_HostAddress}}/api/events
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Konser",
  "description": "Açık hava konseri",
  "venue": "Salon A",
  "startsAt": "2026-12-31T20:00:00Z",
  "capacity": 100
}

### Update event (admin)
PUT {{TicketReservationApi_HostAddress}}/api/events/{{eventId}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Konser",
  "description": "Açık hava konseri",
  "venue": "Salon B",
  "startsAt": "2026-12-31T21:00:00Z",
  "capacity": 120
}

### Cancel event (admin)
PATCH {{TicketReservationApi_HostAddress}}/api/events/{{eventId}}/cancel
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Event reservations (admin)
GET {{TicketReservationApi_HostAddress}}/api/events/{{eventId}}/reservations
Authorization: Bearer {{adminLogin.response.body.$.token}}
Accept: application/json

### Create reservation (user)
POST {{TicketReservationApi_HostAddress}}/api/reservations
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{
  "eventId": "{{eventId}}"
}

### My reservations (user)
GET {{TicketReservationApi_HostAddress}}/api/reservations/me
Authorization: Bearer {{userLogin.response.body.$.token}}
Accept: application/json

### Cancel reservation (user)
PATCH {{TicketReservationApi_HostAddress}}/api/reservations/{{reservationId}}/cancel
Authorization: Bearer {{userLogin.response.body.$.token}}

###
